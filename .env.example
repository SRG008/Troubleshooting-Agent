# LLM chain: ordered "provider:model" entries, tried left to right on failure.
# Providers: gemini, openai (any OpenAI-compatible API), anthropic.
# Entries whose API key is not set are skipped.
# If empty, falls back to gemini:$GEMINI_MODEL with Flash-Lite backups.
LLM_CHAIN="gemini:gemini-flash-lite-latest,gemini:gemini-3.1-flash-lite"
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.1

# Google Gemini Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"
EMBEDDING_MODEL="gemini-embedding-001"

# OpenAI (or any OpenAI-compatible endpoint: Azure OpenAI, Groq, Ollama, ...)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic
ANTHROPIC_API_KEY=""

# Jira OAuth 2.0 (3LO) App Credentials (from developer.atlassian.com)
JIRA_CLIENT_ID="your-atlassian-oauth-client-id"
JIRA_CLIENT_SECRET="your-atlassian-oauth-client-secret"
JIRA_REDIRECT_URI="http://localhost:8000/auth/jira/callback"

# Application URLs
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:8501"

# LLM chain: ordered "provider:model" entries, tried left to right on failure.
# Providers: gemini, openai (any OpenAI-compatible API), anthropic.
# Entries whose API key is not set are skipped.
# If empty, falls back to gemini:$GEMINI_MODEL with Flash-Lite backups.
LLM_CHAIN="gemini:gemini-flash-lite-latest,gemini:gemini-3.1-flash-lite"
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.1

# Google Gemini Configuration
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"
EMBEDDING_MODEL="gemini-embedding-001"

# OpenAI (or any OpenAI-compatible endpoint: Azure OpenAI, Groq, Ollama, ...)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic
ANTHROPIC_API_KEY=""

# Jira through the Atlassian Rovo MCP server. No client ID or secret is needed: on first sign-in the
# backend registers itself with Atlassian (dynamic client registration) for this redirect URI.
ATLASSIAN_MCP_URL="https://mcp.atlassian.com/v2/mcp"
# Add delete:jira:agent-interface or manage:jira:agent-interface only if your Atlassian admin enabled them.
# read:me, read:account and offline_access are always added: Atlassian's consent form requires them.
ATLASSIAN_MCP_SCOPES="read:jira:agent-interface write:jira:agent-interface search:jira:agent-interface read:me read:account offline_access"
JIRA_REDIRECT_URI="http://localhost:8000/auth/jira/callback"

# GitHub OAuth App (from your GitHub organization's Developer settings)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_REDIRECT_URI="http://localhost:8000/auth/github/callback"
# Organization login (slug), not the display name
GITHUB_ORGANIZATION="your-org-login"

# Application URLs
BACKEND_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:8501"

# Outbound network (corporate networks). Python cannot read the PAC file that Zscaler and similar
# agents configure in Windows, so set their local proxy here, e.g. "http://127.0.0.1:9000" for Zscaler.
HTTPS_PROXY=""
# Trust the operating system's certificate store (needed when a proxy inspects HTTPS).
USE_SYSTEM_CERTIFICATES=true
